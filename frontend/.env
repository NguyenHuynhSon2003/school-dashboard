# Đổi tên file này thành .env và đặt trong thư mục frontend/ (cùng cấp với package.json, index.html)
# Sau khi sửa phải tắt và chạy lại `npm run dev` thì Vite mới đọc giá trị mới.

# Chạy backend cùng máy:
VITE_API_URL=http://localhost:3000/api/v1

# Backend ở máy khác trong mạng nội bộ: thay bằng IP máy backend (xem bằng lệnh ipconfig), ví dụ:
# VITE_API_URL=http://192.168.1.50:3000/api/v1